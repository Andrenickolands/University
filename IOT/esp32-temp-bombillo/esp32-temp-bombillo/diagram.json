{
  "version": 1,
  "author": "Nicolás Sepúlveda Amaya",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": -20,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -140,
      "left": 200,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 100,
      "left": 280,
      "attrs": { "color": "yellow", "label": "Bombillo" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 150,
      "left": 300,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
